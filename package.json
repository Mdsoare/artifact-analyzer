{
  "name": "artifact-analyzer",
  "version": "1.0.0",
  "description": "Analisador Estatístico de Artefatos com triagem por hash via VirusTotal API v3",
  "main": "assets/js/script.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:js": "eslint \"assets/js/**/*.js\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:md",
    "lint:css:fix": "stylelint \"assets/css/**/*.css\" --fix",
    "lint:js:fix": "eslint \"assets/js/**/*.js\" --fix",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "test": "npm run lint"
  },
  "keywords": ["devsecops", "threat-intel", "virustotal", "sha256", "security"],
  "author": "Marcelo Soares",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli2": "^0.23.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.2"
  }
}